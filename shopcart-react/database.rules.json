{
  "rules": {
    "products": {
      ".read": true,
      "$productId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['id', 'name', 'price']) && newData.numChildren() <= 12",
        "id": {
          ".validate": "newData.isNumber()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "desc": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "rating": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 5)"
        },
        "reviews": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "image": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "type": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "color": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "material": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "offer": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },
        "updatedAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChild('profile') && newData.numChildren() <= 6",
        "profile": {
          ".validate": "newData.hasChildren(['name', 'email']) && newData.numChildren() <= 4",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 254"
          },
          "address": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)"
          },
          "updatedAt": {
            ".validate": "!newData.exists() || newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "cart": {
          ".validate": "!newData.exists() || newData.isList()"
        },
        "wishlist": {
          ".validate": "!newData.exists() || newData.isList()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "suspended": {
          ".validate": "newData.isBoolean()"
        },
        "suspendedAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && auth.token.email === 'admin@gmail.com' && newData.val() === true))",
        ".validate": "!newData.exists() || newData.val() === true"
      }
    },
    "orders": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (query.orderByChild === 'userId' && query.equalTo === auth.uid))",
      "$orderId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || data.child('userId').val() === auth.uid)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('userId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['userId', 'items', 'subtotal', 'shipping', 'discount', 'total', 'paymentMethod', 'createdAt']) && newData.numChildren() <= 20 && newData.child('userId').isString() && newData.child('items').isList() && newData.child('subtotal').isNumber() && newData.child('shipping').isNumber() && newData.child('discount').isNumber() && newData.child('total').isNumber() && newData.child('paymentMethod').isString() && newData.child('createdAt').isNumber() && (!newData.child('status').exists() || newData.child('status').val() in ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled', 'refunded']) && (!newData.child('statusUpdatedAt').exists() || newData.child('statusUpdatedAt').isNumber())",
        "userId": { ".validate": "newData.isString()" },
        "customerName": { ".validate": "!newData.exists() || newData.isString()" },
        "customerEmail": { ".validate": "!newData.exists() || newData.isString()" },
        "deliveryAddress": { ".validate": "!newData.exists() || newData.isString()" },
        "items": { ".validate": "newData.isList() && newData.numChildren() <= 100" },
        "subtotal": { ".validate": "newData.isNumber()" },
        "shipping": { ".validate": "newData.isNumber()" },
        "discount": { ".validate": "newData.isNumber()" },
        "total": { ".validate": "newData.isNumber()" },
        "paymentMethod": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "status": { ".validate": "!newData.exists() || newData.val() in ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled', 'refunded']" },
        "statusUpdatedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
        "progress": { ".validate": "!newData.exists() || newData.isNumber()" },
        "payfastAmount": { ".validate": "!newData.exists() || newData.isNumber()" },
        "payfastPaymentId": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
        "paymentStatus": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 20)" },
        "paypalOrderId": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
        "$other": { ".validate": false }
      }
    },
    "userSessions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "$sessionId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['startedAt', 'lastSeenAt']) && newData.numChildren() === (newData.hasChild('endedAt') ? 3 : 2)",
          "startedAt": {
            ".validate": "newData.isNumber()"
          },
          "lastSeenAt": {
            ".validate": "newData.isNumber()"
          },
          "endedAt": {
            ".validate": "!newData.exists() || newData.isNumber()"
          }
        }
      }
    },
    "userInputs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "$eventId": {
          ".validate": "newData.hasChildren(['type', 'data', 'timestamp']) && newData.numChildren() === 3",
          "type": {
            ".validate": "newData.isString() && (newData.val() == 'search' || newData.val() == 'filter' || newData.val() == 'form_submission' || newData.val() == 'page_view' || newData.val() == 'add_to_cart')"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "data": {
            ".validate": "newData.hasChildren() && newData.numChildren() <= 12",
            "query": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
            "filters": { ".validate": "!newData.exists() || (newData.hasChildren() && newData.numChildren() <= 12)" },
            "formName": { ".validate": "!newData.exists() || (newData.isString() && (newData.val() == 'signin' || newData.val() == 'signup' || newData.val() == 'checkout'))" },
            "formData": { ".validate": "!newData.exists() || (newData.hasChildren() && newData.numChildren() <= 12)" },
            "page": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
            "referrer": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
            "productId": { ".validate": "!newData.exists() || newData.isNumber()" },
            "productName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
            "quantity": { ".validate": "!newData.exists() || newData.isNumber()" },
            "color": { ".validate": "!newData.exists() || newData.isString()" },
            "price": { ".validate": "!newData.exists() || newData.isNumber()" },
            "items": { ".validate": "!newData.exists() || newData.hasChildren()" },
            "subtotal": { ".validate": "!newData.exists() || newData.isNumber()" },
            "shipping": { ".validate": "!newData.exists() || newData.isNumber()" },
            "discount": { ".validate": "!newData.exists() || newData.isNumber()" },
            "total": { ".validate": "!newData.exists() || newData.isNumber()" },
            "paymentMethod": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}